{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm ci --workspaces --include-workspace-root && npm run build -w @snooker/game" },
  "deploy": {
    "startCommand": "npx --yes serve -s game/dist -l $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
