{
  "name": "@snooker/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram Mini App front-end: canvas snooker table, practice AI, PvP client.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node test/drive-practice.mjs",
    "smoke:concede": "node test/drive-concede.mjs",
    "smoke:offline": "node test/drive-offline.mjs",
    "start": "serve -s dist --no-port-switching"
  },
  "dependencies": {
    "@snooker/sim": "*",
    "@tonconnect/ui": "^2.0.11",
    "matter-js": "^0.20.0",
    "serve": "^14.2.4",
    "@snooker/cosmetics": "*"
  },
  "devDependencies": {
    "vite": "^6.0.3",
    "playwright-core": "^1.49.0"
  }
}
