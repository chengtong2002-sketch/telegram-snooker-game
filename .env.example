#############################################
# Telegram Snooker — copy to .env and fill in
#############################################
# One file at the repo root is enough for local development: bot, backend and
# token scripts all read it. On Railway, set these per-service instead.

# ---------- Telegram ----------
# From @BotFather. The backend needs it too — it verifies Mini App initData
# signatures with the same token.
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Public HTTPS URL of the built /game front-end. Telegram refuses to open http://.
# Local dev: run `npm run dev:game` and expose it (e.g. ngrok / cloudflared).
GAME_URL=https://your-game.up.railway.app

# Where the Mini App calls the backend. Must be reachable from the phone.
BACKEND_URL=http://localhost:8080

# Leave blank for long polling (fine locally and for a demo). To use webhooks,
# set this to https://<bot-service>/telegram/<INTERNAL_API_KEY>.
BOT_WEBHOOK_URL=
BOT_PORT=8081

# ---------- Backend ----------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Sign your own: `openssl rand -hex 32`. Required in production.
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_TTL=12h

# Shared secret between bot and backend for /internal routes. Also used as the
# webhook path segment. `openssl rand -hex 24`.
INTERNAL_API_KEY=change-me-too

# CORS. Must list the exact Mini App origin in production; * is dev-only.
ALLOWED_ORIGINS=*

# Lets the Mini App log in without Telegram initData (browser development).
# MUST be false in production — it would let anyone claim any account.
ALLOW_DEV_AUTH=true

# 20–30 per the game design.
SHOT_CLOCK_SECONDS=25

# ---------- Database ----------
# Empty = SQLite at ./data/snooker.sqlite. To move to Postgres (Railway gives
# you this variable automatically), set it and re-run migrations — the schema
# and every query are engine-agnostic.
DATABASE_URL=
# SQLITE_PATH=./data/snooker.sqlite
# PGSSL=disable

# ---------- Rewards ----------
# rate = budget ÷ total eligible points in the period, so the budget is a hard
# ceiling: more players earning points dilutes the per-point rate.
REWARD_PERIOD_KIND=daily        # daily | weekly
REWARD_BUDGET_TOKENS=1000
REWARD_MAX_SHARE=0.25           # no single player takes more than 25% of a period
REWARD_MIN_POINTS=10            # below this, redemption is not worth the gas
# Test accounts only: Telegram user ids (comma-separated) that bypass the daily
# limits (15 eligible matches / 3 per opponent per UTC day) and the 24h claim
# cooldown after a wallet change. Leave empty outside testnet.
REWARD_LIMIT_EXEMPT_TELEGRAM_IDS=

# ---------- TON ----------
# testnet until the whole flow has been exercised end to end.
TON_NETWORK=testnet

# 24 words for the treasury wallet. KEEP THIS OUT OF GIT.
# Testnet funds: @testgiver_ton_bot on Telegram.
TON_WALLET_MNEMONIC="word1 word2 word3 ... word24"
# Wallet contract version the mnemonic was used with in your wallet app. The same
# words give a different address per version. Tonkeeper / Telegram Wallet: v5r1.
TON_WALLET_VERSION=v5r1


# Filled in by `npm run deploy -w @snooker/token`.
JETTON_MASTER_ADDRESS=

JETTON_NAME=Snooker Points
JETTON_SYMBOL=SNKR
JETTON_DECIMALS=9
JETTON_DESCRIPTION=In-game reward token for the Snooker Mini App.
JETTON_IMAGE_URL=

# Safety catch: mainnet scripts refuse to run unless this is exactly "yes".
I_UNDERSTAND_THIS_IS_MAINNET=

# ---------- TON Connect ----------
# Served from /game/public/tonconnect-manifest.json — update the URLs in it too.
TONCONNECT_MANIFEST_URL=https://your-game.up.railway.app/tonconnect-manifest.json
# Domains a ton_proof may be signed for. Empty accepts any (dev only).
TONCONNECT_ALLOWED_DOMAINS=your-game.up.railway.app

# ---------- Mini App build-time ----------
# Vite inlines these at build time, so they belong to the /game service.
VITE_BACKEND_URL=http://localhost:8080
VITE_TONCONNECT_MANIFEST_URL=https://your-game.up.railway.app/tonconnect-manifest.json
